{
    "name": "webwings",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "install:api": "cd apps/api && go mod tidy",
        "postinstall": "npm run install:api",
        "dev": "cross-env NODE_ENV=development dotenv -- turbo watch dev",
        "db:migrate": "dotenv -- turbo run db:migrate",
        "db:seed": "dotenv -- turbo run db:seed",
        "generate": "dotenv -- turbo run generate",
        "build": "cross-env NODE_ENV=production dotenv -- turbo run build",
        "start": "cross-env NODE_ENV=production dotenv -- turbo run start"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "cross-env": "^7.0.3",
        "dotenv-cli": "^8.0.0",
        "turbo": "^2.4.4"
    },
    "workspaces": [
        "apps/*"
    ],
    "packageManager": "^npm@10.2.3"
}
